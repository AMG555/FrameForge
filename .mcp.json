{
  "mcpServers": {
    "video-pipeline": {
      "command": "node",
      "args": ["src/mcp-server/server.js"],
      "env": {
        "PROVIDER_LLM":    "${PROVIDER_LLM:-groq}",
        "GROQ_API_KEY":    "${GROQ_API_KEY}",
        "PROVIDER_TTS":    "${PROVIDER_TTS:-edge-tts}",
        "PROVIDER_IMAGE":  "${PROVIDER_IMAGE:-pollinations}",
        "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
        "TELEGRAM_CHAT_ID":   "${TELEGRAM_CHAT_ID}",
        "TELEGRAM_API_BASE":  "${TELEGRAM_API_BASE:-https://api.telegram.org}",
        "N8N_FILES_DIR":   "${N8N_FILES_DIR:-/home/node/.n8n-files}",
        "MCP_PORT":        "${MCP_PORT:-3210}"
      }
    }
  }
}
