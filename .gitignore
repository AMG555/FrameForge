out/chunks/
tmp/
source/

# ── n8n local runtime ────────────────────────────────────────────────────────
.n8n/
.n8n-files/
video_tmp/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.ndjson
!src/**/*.ndjson

