# FrameForge Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env: cp docs/env.template .env
# Or use the interactive wizard: npm run setup
# NEVER commit .env to git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: groq | cerebras | openrouter | anthropic | gemini | mistral | together | openai | ollama | webhook
# Note: When using the Cloudflare Remote MCP path, the IDE agent (IBM Bob / Cursor /
# Windsurf / Codex / opencode) provides the intelligence. FrameForge only needs an LLM
# key when the pipeline runs its own research or script generation stages.
PROVIDER_LLM=groq

# ── Free / fastest ────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_REPLACE_WITH_REAL_KEY       # groq:    console.groq.com  (free)
# CEREBRAS_API_KEY=REPLACE_WITH_REAL_KEY     # cerebras: cloud.cerebras.ai (free tier)

# ── Router (one key → every model) ───────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-REPLACE           # openrouter: openrouter.ai
#   Override model: LLM_MODEL=google/gemini-2.0-flash-exp

# ── Direct cloud APIs ─────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-REPLACE           # anthropic: console.anthropic.com
# GEMINI_API_KEY=REPLACE                     # gemini:    aistudio.google.com (free)
# MISTRAL_API_KEY=REPLACE                    # mistral:   console.mistral.ai
# TOGETHER_API_KEY=REPLACE                   # together:  api.together.ai
# OPENAI_API_KEY=sk-REPLACE                  # openai:    platform.openai.com

# ── Local / self-hosted ───────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/api
# OLLAMA_MODEL=llama3.3

# ── Override default model for any provider ───────────────────────────────────
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Image Generation ─────────────────────────────────────────────────────────
# Options: pollinations | falai | replicate | dalle | webhook
PROVIDER_IMAGE=pollinations
# FALAI_API_KEY=REPLACE
# REPLICATE_API_KEY=r8_REPLACE
# (OPENAI_API_KEY also covers dalle)

# ── TTS Provider ─────────────────────────────────────────────────────────────
# Options: edge-tts | elevenlabs | azure | openai | webhook
# Tip: use multi_voice_tts MCP tool to call any platform per-request without
# changing these global settings.
PROVIDER_TTS=edge-tts
# ELEVENLABS_API_KEY=REPLACE
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB    # voice ID (default = Adam)
# AZURE_SPEECH_KEY=REPLACE
# AZURE_SPEECH_REGION=eastus
# (OPENAI_API_KEY also covers openai tts)

# ── TTS Voice Settings ────────────────────────────────────────────────────────
# TTS_RATE=-5%                    # speaking rate (-50% to +50%)
# TTS_VOICE=en-US-GuyNeural       # override default narrator voice
# TTS_VOICE_GENDER=Male           # Male | Female (used by auto-selector)

# ── Delivery ─────────────────────────────────────────────────────────────────
# file channel:    videos are copied to N8N_FILES_DIR/published/ (default, no config needed)
# webhook channel: POST a JSON summary to any HTTP endpoint
# PUBLISH_WEBHOOK_URL=https://hooks.example.com/frameforge   # optional

# ── Fact-checker review notifications ────────────────────────────────────────
# Optional: POST review requests to any HTTP endpoint (n8n, Make, Zapier, custom bot)
# REVIEW_NOTIFY_URL=https://hooks.example.com/review-gate

# ── File Paths ────────────────────────────────────────────────────────────────
N8N_FILES_DIR=/home/node/.n8n-files
MCP_PORT=3210
WORKER_PORT=3211

# ── Worker API URL (for queue_full_pipeline MCP tool) ────────────────────────
# WORKER_API_URL=http://localhost:3211  # or https://your-render-app.onrender.com

# ── Cloudflare Remote MCP (primary connection method) ────────────────────────
# These are set via wrangler secrets — not in .env:
#   wrangler secret put WORKER_API_URL
#   wrangler secret put MCP_AUTH_TOKEN
#   wrangler secret put INTERNAL_API_TOKEN
#
# Your IDE's MCP config (same URL for any IDE):
#   { "url": "https://video-mcp.YOUR_SUBDOMAIN.workers.dev/mcp",
#     "headers": { "Authorization": "Bearer YOUR_MCP_AUTH_TOKEN" } }

# ── Hybrid Deployment ────────────────────────────────────────────────────────
RENDER_MODE=api_only              # api_only | full
LOCAL_RENDER_URL=                 # http://192.168.1.100:3211  (LAN) or Tailscale URL
INTERNAL_API_TOKEN=REPLACE_WITH_32_BYTE_HEX

# ── External Platform Adapter (optional) ─────────────────────────────────────
# EXTERNAL_PLATFORM_NAME=voxforge
# EXTERNAL_PLATFORM_URL=https://api.voxforge.io
# EXTERNAL_PLATFORM_KEY=REPLACE
# EXTERNAL_PLATFORM_INGEST_PATH=/v1/ingest
# EXTERNAL_PLATFORM_RENDER_PATH=/v1/render
# EXTERNAL_PLATFORM_STATUS_PATH=/v1/status

# ── PostgreSQL (optional — file mode used if not set) ────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/video_agent

# ── Debug ─────────────────────────────────────────────────────────────────────
# DEBUG_PROVIDERS=1    # verbose provider retry logging
