{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene Schema v2.0.0",
  "description": "Scene definition for FrameForge pipeline. character_id is a free-form string since v2.0.0.",
  "type": "object",
  "required": ["scene_id", "schema_version", "narration", "visual_description"],
  "properties": {
    "scene_id": { "type": "integer", "minimum": 0 },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "default": "2.0.0" },
    "narration": { "type": "string", "minLength": 1, "maxLength": 500 },
    "caption": { "type": "string", "maxLength": 100 },
    "video_path": { "type": "string", "description": "Optional path to user-supplied video clip or B-roll" },
    "image_path": { "type": "string", "description": "Optional path to user-supplied static image" },
    "audio_path": { "type": "string", "description": "Optional path to user-supplied pre-recorded voiceover" },
    "visual_description": { "type": "string", "minLength": 1 },
    "character": {
      "type": "object",
      "properties": {
        "character_id": {
          "type": "string",
          "description": "Free-form character identifier. Use 'none' for no character. Any string is valid since schema v2.0.0."
        },
        "pose": { "type": "string" },
        "emotion": { "type": "string" },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
            "y": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
            "scale": { "type": "number", "minimum": 0.5, "maximum": 2.0, "default": 1.0 }
          }
        }
      }
    },
    "focal_point": {
      "type": "object",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
      },
      "required": ["x", "y"]
    },
    "overlay": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["prop", "effect", "text", "none"] },
        "asset_id": { "type": "string" },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
            "scale": { "type": "number", "minimum": 0.1, "maximum": 5.0, "default": 1.0 },
            "rotation": { "type": "number", "minimum": -180, "maximum": 180, "default": 0 }
          }
        }
      }
    },
    "sound_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect_id": { "type": "string" },
          "timing": { "type": "string", "enum": ["start", "middle", "end", "continuous"] },
          "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 }
        }
      }
    },
    "music_mood": {
      "type": "string",
      "enum": ["tense", "calm", "energetic", "mysterious", "neutral", "dramatic", "humorous"]
    },
    "camera_hint": {
      "type": "string",
      "enum": [
        "zoom_in", "zoom_out",
        "slow_zoom_in", "slow_zoom_out",
        "pan_left", "pan_right",
        "tilt_up", "tilt_down",
        "ken_burns",
        "static", "auto"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "importance": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "hook_potential": { "type": "number", "minimum": 0, "maximum": 1 },
        "standalone": { "type": "boolean" }
      }
    }
  }
}
