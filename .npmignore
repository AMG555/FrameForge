# FrameForge .npmignore
# Files excluded from the npm package (users get just the runtime, not the dev/test scaffolding)

# Tests
**/*.test.js
src/integration.test.js

# Dev scripts
scripts/
!scripts/html-renderer/
.github/
.cursor/
.kiro/

# IDE rules (users set up their own)
.cursorrules
.windsurfrules
AGENT.md

# Docs source (available on GitHub; not needed at runtime)
docs/

# Cloudflare worker (separate deployment, not needed for npx)
cloudflare-mcp/


# Render config
render.yaml

# Generated output files (frames, renders, previews) — not needed in the package
out/
output/

# Bob artifacts / session files
.bob/

# harness test fixtures
src/harness/test/

# Local dev files
.env
.env.*
*.log
*.local

# Coverage / cache
coverage/
.nyc_output/
node_modules/
__pycache__/
*.pyc
*.pyo

.agent/

# Style sheet preview images (large PNG previews, not needed in npm CLI)
plugins/**/style-sheet.png
**/*.png
**/*.jpg
**/*.jpeg

